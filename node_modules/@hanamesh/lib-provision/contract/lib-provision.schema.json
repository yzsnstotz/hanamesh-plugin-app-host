{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yzsnstotz/hanamesh-lib-provision/contract/lib-provision.schema.json",
  "title": "@hanamesh/lib-provision supply contract",
  "description": "provider: what one released version actually ships. requirement: what a consumer needs. version is the package SemVer; manifestSchema is the provision manifest data format number and is never compared as SemVer.",
  "$defs": {
    "names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "provider": {
      "type": "object",
      "required": ["package", "version", "source", "exports", "bin", "api", "cli", "manifestSchema", "runtimeDependencies"],
      "additionalProperties": false,
      "properties": {
        "package": {"const": "@hanamesh/lib-provision"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$"},
        "source": {
          "type": "object",
          "required": ["git", "tag"],
          "additionalProperties": false,
          "properties": {
            "git": {"const": "git+https://github.com/yzsnstotz/hanamesh-lib-provision.git"},
            "tag": {"type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$"}
          }
        },
        "exports": {"$ref": "#/$defs/names"},
        "bin": {"type": "object", "additionalProperties": {"type": "string"}},
        "api": {"$ref": "#/$defs/names"},
        "cli": {"$ref": "#/$defs/names"},
        "manifestSchema": {"const": 1},
        "runtimeDependencies": {"const": 0}
      }
    },
    "requirement": {
      "type": "object",
      "required": ["package", "range", "major", "api", "bin", "cli", "manifestSchema"],
      "additionalProperties": false,
      "properties": {
        "package": {"const": "@hanamesh/lib-provision"},
        "range": {"type": "string", "pattern": "^git\\+https://github\\.com/yzsnstotz/hanamesh-lib-provision\\.git#semver:"},
        "major": {"type": "integer", "minimum": 0},
        "api": {"$ref": "#/$defs/names"},
        "bin": {"$ref": "#/$defs/names"},
        "cli": {"$ref": "#/$defs/names"},
        "manifestSchema": {"const": 1}
      }
    }
  }
}
