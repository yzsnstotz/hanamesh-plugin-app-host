{
  "name": "@hanamesh/lib-provision",
  "version": "0.2.1",
  "description": "Safely place a large file on the user's machine: source selection, resumable download, sha256, sandboxed extraction, atomic promotion, ledger.",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "bin": {
    "hanamesh-provision": "bin/hanamesh-provision.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./contract/*": "./contract/*",
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib/",
    "bin/",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "consistency.json",
    "contract/",
    "LICENSE"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=tap tests/*.test.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "test:mutation": "node scripts/mutations.mjs",
    "check:consistency": "node scripts/check-consistency.mjs",
    "check:lib": "node scripts/check-lib.mjs",
    "check": "hanamesh-devkit check-toolchain && hanamesh-devkit preflight && node scripts/check-consistency.mjs && node scripts/check-lib.mjs",
    "verify:pack": "bash scripts/verify-artifact.sh",
    "preflight": "hanamesh-devkit preflight"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "typescript": "5.9.3",
    "undici-types": "6.21.0",
    "@hanamesh/devkit": "git+https://github.com/yzsnstotz/hanamesh-server-shared.git#semver:^0.2.0&path:/packages/devkit"
  }
}
